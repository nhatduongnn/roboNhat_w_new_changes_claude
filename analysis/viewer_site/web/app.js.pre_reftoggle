}
function seqAt(p){
  for (const b of sharedBlocks()) if (p >= b.start && p < b.start + b.len) return b.seq[p - b.start];
  return null;
}
function drawSeq(){
  const c = cv.cSeq, ctx = c.getContext("2d"), h = H.cSeq;
