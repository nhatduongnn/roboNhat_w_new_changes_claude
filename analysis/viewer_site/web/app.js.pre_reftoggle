async function setRuns(ids, chrom, view){
  V.runs = ids.filter(id => BYID[id]);
  renderChips();
  const cs = coveredChroms();
  let c = chrom && cs.includes(chrom) ? chrom : (cs.includes(V.chrom) ? V.chrom : (cs.find(x => WINDOW_CHROMS.has(x)) || cs[0]));
