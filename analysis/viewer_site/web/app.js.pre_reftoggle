      const a = Math.max(V.view.s, b.start), e = Math.min(V.view.e, b.start + b.len - 1);
      for (let p = a; p <= e; p++){ const v = b.aw[p - b.start] + b.ac[p - b.start]; if (v) ctx.fillRect(xOf(p) - w / 2, y(v), w, y0 - y(v)); }
    }
