# Large per-run decode/training outputs (20-210 MB each, regenerate via sbatch_*.sh; kept local)
analysis/robocop_chrI_maskon/
analysis/robocop_chrI_maskoff/
analysis/robocop_chrI_seq_maskon/
analysis/robocop_chrI_seq_maskoff/
analysis/robocop_seqlayer_maskon/
analysis/robocop_seqlayer_maskoff/
analysis/robocop_erv46_maskon/
analysis/robocop_erv46_maskoff/
analysis/robocop_train_fiberonly/
# Regenerable model-artifact binaries inside tracked decode dirs
analysis/**/HMMconfig*.pkl
analysis/**/negParamsMNase.pkl
# Posterior tables. Every decode dir is 55-434 MB and essentially all of it is here;
# the rest of the dir (config.ini, coords.tsv, pwm.p, figures/, score_report.json) is
# small and IS tracked, so a run stays reproducible from what is committed.
analysis/**/tmpDir/
# Full FIMO placement tables (--thresh 1 --text over a whole chromosome, 33 MB each).
# The filtered fimo_out/ results next to them are tracked.
analysis/**/fimo_all.tsv
# Ephemeral job-tracking scratch and run logs
analysis/logs/
analysis/.*_jobid
analysis/.*_ids
analysis/.last_job_ids
analysis/.score5_optionA.log
analysis/.*.sh

# TOMTOM comparison tables (60 MB across 6 files). Regenerate with
# analysis/build_motif_dbs.py; the .meme databases they are built from ARE tracked,
# so the comparison stays reproducible from what is committed.
analysis/motifdb/tomtom_*.tsv
# Cached sliding-window ABF1 score tracks (8-11 MB each). Regenerate with
# abf1_slide_calibrate.py / slide_abf1_profile.py. The small companion arrays
# (abf1_slide_cov.npz, abf1_profile_pm100_agentA.npz) are tracked.
analysis/abf1_slide_calib_half*.npz
analysis/abf1_slide_tracks.npz
# Stray run logs written next to the scripts rather than into logs/
analysis/*.log
analysis/trash/
analysis/.*_jobids
analysis/.timing.txt
